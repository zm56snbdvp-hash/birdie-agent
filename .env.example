# Birdie Agent environment template
# Never commit real secrets.

PORT=8080
OPENAI_MODEL=gpt-5
OPENAI_API_KEY=
BIRDIE_AGENT_API_KEY=
BIRDIE_FAMILY_API_KEY=
BIRDIE_OS_API_KEY=
BIRDIE_OS_BASE=
BIRDIE_AGENT_URL=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SIGNATURE_TEXT=
MAIL_SIGNATURE_HTML=

# Framer Server API
# Keep FRAMER_API_KEY in Secret Manager/runtime configuration only.
FRAMER_PROJECT_URL=
FRAMER_API_KEY=

# Meta Instagram signed webhook intake
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_INSTAGRAM_USERNAME=birdieandbreakfast
META_INSTAGRAM_ACCOUNT_ID=

# Legacy Facebook/Page OAuth provisioning. OAuth start stays fail-closed until
# the runtime injects a governed storeMetaCredential secret sink.
META_OAUTH_REDIRECT_URI=
META_OAUTH_STATE_SECRET=
META_OAUTH_PAGE_ID=
META_OAUTH_INSTAGRAM_ACCOUNT_ID=

# Optional, only for separately confirmed outbound Instagram messaging.
# Use the verified legacy Facebook Login Page ID/token route only.
# Instagram Login routing is intentionally outside this workstream.
META_MESSAGING_ACCESS_TOKEN=
META_MESSAGING_ACCOUNT_ID=
META_MESSAGING_GRAPH_HOST=graph.facebook.com
META_API_VERSION=v26.0

# BirdieWorld browser auth. The app API remains disabled until all three
# required values are configured. Never expose BIRDIE_AGENT_API_KEY to a client.
BIRDIE_APP_OAUTH_ISSUER=
BIRDIE_APP_OAUTH_AUDIENCE=
BIRDIE_APP_BIRDIE_ID_CLAIM=
BIRDIE_APP_OAUTH_JWKS_URL=
