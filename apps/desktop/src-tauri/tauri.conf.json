{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Birdie",
  "version": "0.1.0-alpha.0",
  "identifier": "com.birdieandbreakfast.birdie.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "core",
      "title": "Birdie",
      "width": 1,
      "height": 1,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "resizable": false,
      "maximizable": false,
      "minimizable": false,
      "alwaysOnTop": false,
      "skipTaskbar": true,
      "focus": false,
      "visible": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../../services/core": "services/core",
      "../../../packages/protocol": "packages/protocol",
      "../../../build/voice/Release/birdie-voice-host.exe": "build/voice/Release/birdie-voice-host.exe",
      "../../../models/whisper/ggml-base.bin": "models/whisper/ggml-base.bin"
    }
  }
}
