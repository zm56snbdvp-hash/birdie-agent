default_platform(:ios)

platform :ios do
  def birdie_api_key
    required = %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_KEY_B64
      APPLE_TEAM_ID
    ]
    missing = required.select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("Missing CI secrets: #{missing.join(', ')}") unless missing.empty?

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_B64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build Birdie and upload to TestFlight from CI"
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = birdie_api_key

    cert(
      api_key: api_key,
      type: "APPLE_DISTRIBUTION",
      generate_apple_certs: true,
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    profiles = {
      "de.birdieandbreakfast.birdie" => "Birdie AppStore",
      "de.birdieandbreakfast.birdie.watchkitapp" => "Birdie Watch AppStore",
      "de.birdieandbreakfast.birdie.watchkitapp.widget" => "Birdie Watch Widget AppStore"
    }

    profiles.each do |bundle_id, profile_name|
      sigh(
        api_key: api_key,
        app_identifier: bundle_id,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        provisioning_name: profile_name,
        force: true
      )
    end

    sh("xcodegen generate")

    increment_build_number(
      xcodeproj: "Birdie.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    build_app(
      project: "Birdie.xcodeproj",
      scheme: "Birdie",
      export_method: "app-store",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Automatic",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build Birdie POV and upload to TestFlight from CI"
  lane :pov_beta do
    setup_ci if ENV["CI"]
    api_key = birdie_api_key
    bundle_id = "de.birdieandbreakfast.pov"

    cert(
      api_key: api_key,
      type: "APPLE_DISTRIBUTION",
      generate_apple_certs: true,
      team_id: ENV.fetch("APPLE_TEAM_ID")
    )

    sigh(
      api_key: api_key,
      app_identifier: bundle_id,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      provisioning_name: "Birdie POV AppStore",
      force: true
    )

    sh("xcodegen generate")

    increment_build_number(
      xcodeproj: "Birdie.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    build_app(
      project: "Birdie.xcodeproj",
      scheme: "BirdiePOV",
      export_method: "app-store",
      clean: true,
      output_name: "BirdiePOV.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Automatic",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true
    )
  end
end
